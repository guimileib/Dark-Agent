/* ============================================================================
   DarkAgent Pro — Dark Theme (Fallback)
   Simplified version of the modern theme for compatibility.
   ============================================================================ */

QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

QPushButton {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2563eb;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #334155;
    color: #64748b;
}

QLineEdit {
    background-color: rgba(15, 23, 42, 0.7);
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 8px 12px;
    color: #f0f4ff;
}

QLineEdit:focus {
    border-color: #3b82f6;
}

QComboBox {
    background-color: rgba(15, 23, 42, 0.7);
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 8px 12px;
    color: #f0f4ff;
}

QComboBox:hover {
    border-color: rgba(59, 130, 246, 0.5);
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #94a3b8;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    border: 1px solid #334155;
    selection-background-color: #3b82f6;
    color: #e2e8f0;
    border-radius: 8px;
    outline: none;
}

QProgressBar {
    border: none;
    border-radius: 5px;
    text-align: center;
    background-color: rgba(30, 41, 59, 0.6);
    color: #e2e8f0;
    font-weight: 600;
    max-height: 10px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6, stop:1 #8b5cf6);
    border-radius: 5px;
}

QGroupBox {
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    margin-top: 12px;
    padding: 18px;
    font-weight: bold;
    background-color: rgba(15, 23, 42, 0.4);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #f0f4ff;
    left: 16px;
}

QLabel {
    color: #e2e8f0;
    background: transparent;
}

QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: rgba(30, 41, 59, 0.8);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #3b82f6;
    border: 2px solid #60a5fa;
    width: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #2563eb;
}

QTextEdit, QPlainTextEdit {
    background-color: rgba(15, 23, 42, 0.7);
    border: 1.5px solid #334155;
    border-radius: 10px;
    color: #f0f4ff;
    padding: 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(148, 163, 184, 0.5);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QCheckBox {
    color: #e2e8f0;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 6px;
    background-color: rgba(15, 23, 42, 0.5);
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

QRadioButton {
    color: #e2e8f0;
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 10px;
    background-color: rgba(15, 23, 42, 0.5);
}

QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background-color: rgba(30, 41, 59, 0.6);
    color: #94a3b8;
    padding: 10px 24px;
    border-radius: 18px;
    margin: 3px;
    font-weight: 600;
    border: 1px solid rgba(51, 65, 85, 0.5);
}

QTabBar::tab:selected {
    background-color: #3b82f6;
    color: white;
    border: none;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(51, 65, 85, 0.6);
    color: #e2e8f0;
}

QToolTip {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    padding: 6px 10px;
    border-radius: 8px;
}

QMenu {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    color: #e2e8f0;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: rgba(59, 130, 246, 0.2);
}

QFrame#GlassContainer {
    background-color: rgba(15, 23, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
}

QListWidget {
    background-color: rgba(10, 15, 28, 0.8);
    border: 1.5px solid rgba(51, 65, 85, 0.5);
    border-radius: 12px;
    color: #e2e8f0;
    font-size: 13px;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 8px;
}

QListWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.2);
}
