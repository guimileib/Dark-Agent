/* ============================================================================
   DarkAgent Pro — Tema shadcn (zinc, dark)

   Tokens:
     background   #09090b      card         #0c0c0e / #111113
     muted        #18181b      accent/hover rgba(255,255,255,0.05)
     border       #27272a      input        #27272a
     foreground   #fafafa      muted-fg     #a1a1aa  (ícones: #71717a)
     primary      #3b82f6      primary-fg   #ffffff   (primary/10 = rgba(59,130,246,.12))
     destructive  #ef4444      success      #22c55e   warning #f59e0b

   Tipografia: Segoe UI / Inter · 13px base · títulos 600
   Raio: botões/inputs 6px · cards 12px · itens de nav 6px
   ============================================================================ */


/* --------------------------------------------------------------------------
   Base
   -------------------------------------------------------------------------- */
QWidget {
    background-color: #09090b;
    color: #e4e4e7;
    font-family: 'Segoe UI', 'Inter', sans-serif;
    font-size: 13px;
    selection-background-color: rgba(59, 130, 246, 0.35);
    selection-color: #fafafa;
}

QMainWindow, QWidget#AppShell {
    background-color: #09090b;
}

/* --------------------------------------------------------------------------
   Shell: Sidebar
   -------------------------------------------------------------------------- */
QFrame#Sidebar {
    background-color: #0c0c0e;
    border: none;
    border-right: 1px solid #1f1f23;
}
QFrame#Sidebar QWidget {
    background: transparent;
}
QScrollArea#SidebarScroll, QWidget#SidebarBody {
    background: transparent;
    border: none;
}
QFrame#SidebarBrand {
    border-radius: 8px;
}
QFrame#SidebarBrand:hover {
    background-color: rgba(255, 255, 255, 0.04);
}
QFrame#Sidebar QLabel#BrandLogo {
    background-color: #3b82f6;
    border-radius: 6px;
}
QLabel#BrandTitle {
    color: #fafafa;
    font-size: 13px;
    font-weight: 600;
}
QLabel#BrandSubtitle {
    color: #71717a;
    font-size: 11px;
}
QLabel#NavHeading {
    color: #52525b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 0 10px 4px 10px;
}
QFrame#NavRow {
    border-radius: 6px;
    background: transparent;
}
QFrame#NavRow[hover="true"] {
    background-color: rgba(255, 255, 255, 0.05);
}
QFrame#NavRow[active="true"] {
    background-color: rgba(255, 255, 255, 0.09);
}
QLabel#NavTitle {
    color: #a1a1aa;
    font-size: 13px;
    letter-spacing: 0.2px;
}
QFrame#NavRow[hover="true"] QLabel#NavTitle {
    color: #e4e4e7;
}
QLabel#NavTitle[active="true"] {
    color: #fafafa;
    font-weight: 600;
}
QFrame#Sidebar QLabel#NavBadge {
    background-color: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 600;
    min-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0 6px;
}
QLabel#Kbd,
QFrame#Sidebar QLabel#Kbd,
QFrame#PaletteCard QLabel#Kbd {
    background-color: rgba(9, 9, 11, 0.6);
    color: #71717a;
    border: 1px solid #27272a;
    border-radius: 4px;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 10px;
    font-weight: 500;
    padding: 1px 6px;
}
QFrame#SidebarFooter {
    border: none;
    border-top: 1px solid #1f1f23;
}

/* --------------------------------------------------------------------------
   Shell: Topbar + conteúdo
   -------------------------------------------------------------------------- */
QFrame#MainArea {
    background-color: #09090b;
    border: none;
}
QFrame#TopBar {
    background-color: #09090b;
    border: none;
    border-bottom: 1px solid #1f1f23;
}
QFrame#TopBar QLabel {
    background: transparent;
}
QLabel#CrumbMuted {
    color: #71717a;
    font-size: 13px;
}
QLabel#CrumbCurrent {
    color: #fafafa;
    font-size: 13px;
    font-weight: 600;
}
QWidget#ContentArea {
    background-color: #09090b;
}
QStackedWidget {
    background: transparent;
}

QPushButton#GhostIconButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px;
    min-width: 0;
}
QPushButton#GhostIconButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
}
QPushButton#SearchTrigger {
    background-color: rgba(255, 255, 255, 0.04);
    color: #71717a;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 400;
    text-align: left;
}
QPushButton#SearchTrigger:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #a1a1aa;
}

/* --------------------------------------------------------------------------
   Paleta de comandos
   -------------------------------------------------------------------------- */
QWidget#PaletteOverlay {
    background: transparent;
}
QFrame#PaletteCard {
    background-color: #111113;
    border: 1px solid #27272a;
    border-radius: 12px;
}
QFrame#PaletteCard QWidget {
    background: transparent;
}
QFrame#PaletteBar {
    border: none;
    border-bottom: 1px solid #27272a;
    min-height: 52px;
}
QLineEdit#PaletteInput {
    background: transparent;
    border: none;
    padding: 14px 0;
    font-size: 14px;
    color: #fafafa;
}
QLineEdit#PaletteInput:focus {
    border: none;
    background: transparent;
}
QListWidget#PaletteList {
    background: transparent;
    border: none;
    padding: 6px;
}
QListWidget#PaletteList::item {
    padding: 8px 10px;
    border: none;
    border-radius: 6px;
    color: #d4d4d8;
    min-height: 22px;
}
QListWidget#PaletteList::item:selected {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fafafa;
}
QListWidget#PaletteList::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.04);
}
QLabel#MutedLabel {
    color: #71717a;
    font-size: 13px;
    font-weight: 500;
}

/* --------------------------------------------------------------------------
   Scrollbars
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #27272a;
    min-height: 30px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #3f3f46;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #27272a;
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #3f3f46;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* --------------------------------------------------------------------------
   Tabs (sub-abas dentro das páginas) — estilo "tabs" do shadcn
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    border: none;
    background: transparent;
}
QTabWidget::tab-bar {
    alignment: left;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: #18181b;
    color: #a1a1aa;
    padding: 6px 14px;
    margin: 0 2px 8px 0;
    border-radius: 6px;
    font-weight: 500;
    font-size: 13px;
    border: 1px solid transparent;
}
QTabBar::tab:selected {
    background: #27272a;
    color: #fafafa;
    border: 1px solid #3f3f46;
}
QTabBar::tab:hover:!selected {
    color: #e4e4e7;
}

/* --------------------------------------------------------------------------
   Inputs
   -------------------------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 7px 10px;
    color: #fafafa;
    font-size: 13px;
    selection-background-color: rgba(59, 130, 246, 0.35);
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #3f3f46;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #52525b;
    background-color: rgba(255, 255, 255, 0.03);
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: #52525b;
    background-color: transparent;
}
QLineEdit[readOnly="true"] {
    color: #a1a1aa;
}

QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 6px 10px;
    color: #fafafa;
    font-size: 13px;
}
QSpinBox:hover, QDoubleSpinBox:hover, QTimeEdit:hover, QDateEdit:hover {
    border-color: #3f3f46;
}
QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QDateEdit:focus {
    border-color: #52525b;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QTimeEdit::up-button, QDateEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background: transparent;
    border: none;
    width: 18px;
    height: 12px;
    margin-right: 2px;
    border-radius: 3px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button,
QTimeEdit::down-button, QDateEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background: transparent;
    border: none;
    width: 18px;
    height: 12px;
    margin-right: 2px;
    border-radius: 3px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QTimeEdit::up-button:hover, QDateEdit::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover,
QTimeEdit::down-button:hover, QDateEdit::down-button:hover {
    background: rgba(255, 255, 255, 0.06);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QTimeEdit::up-arrow, QDateEdit::up-arrow {
    image: url({ICONS_DIR}/arrow_up.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QTimeEdit::down-arrow, QDateEdit::down-arrow {
    image: url({ICONS_DIR}/arrow_down.svg);
    width: 10px;
    height: 10px;
}
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 24px;
    border: none;
}

/* --------------------------------------------------------------------------
   Buttons — default = secondary (zinc); #BtnPrimary = azul; #BtnSecondary = outline;
   #danger = destructive; #ProcessButton/#CtaButton = CTA claro
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #27272a;
    color: #fafafa;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #323238;
}
QPushButton:pressed {
    background-color: #3f3f46;
}
QPushButton:disabled {
    background-color: #18181b;
    color: #52525b;
    border-color: #27272a;
}
QPushButton:focus {
    outline: none;
}

QPushButton#BtnPrimary {
    background-color: #3b82f6;
    color: #ffffff;
}
QPushButton#BtnPrimary:hover {
    background-color: #2f74e8;
}
QPushButton#BtnPrimary:pressed {
    background-color: #2563eb;
}

QPushButton#BtnSecondary {
    background-color: transparent;
    color: #e4e4e7;
    border: 1px solid #27272a;
}
QPushButton#BtnSecondary:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #fafafa;
}
QPushButton#danger {
    background-color: #dc2626;
    color: #fafafa;
}
QPushButton#danger:hover {
    background-color: #b91c1c;
}

/* CTA principal (Legendas) — primary sólido, sem gradiente */
QPushButton#ProcessButton, QPushButton#CtaButton,
QFrame#EditorPanel QPushButton#ProcessButton {
    background-color: #fafafa;
    color: #09090b;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 24px;
}
QPushButton#ProcessButton:hover, QPushButton#CtaButton:hover,
QFrame#EditorPanel QPushButton#ProcessButton:hover {
    background-color: #e4e4e7;
}
QPushButton#ProcessButton:pressed, QPushButton#CtaButton:pressed,
QFrame#EditorPanel QPushButton#ProcessButton:pressed {
    background-color: #d4d4d8;
}
QPushButton#ProcessButton:disabled, QPushButton#CtaButton:disabled,
QFrame#EditorPanel QPushButton#ProcessButton:disabled {
    background-color: #18181b;
    color: #52525b;
}

/* --------------------------------------------------------------------------
   ComboBox
   -------------------------------------------------------------------------- */
QComboBox {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 6px 10px;
    color: #fafafa;
    font-size: 13px;
    min-height: 20px;
}
QComboBox:hover {
    border-color: #3f3f46;
}
QComboBox:focus {
    border-color: #52525b;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}
QComboBox::down-arrow {
    image: url({ICONS_DIR}/arrow_down.svg);
    width: 10px;
    height: 10px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #111113;
    border: 1px solid #27272a;
    selection-background-color: rgba(255, 255, 255, 0.08);
    selection-color: #fafafa;
    color: #e4e4e7;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
    min-height: 26px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

/* --------------------------------------------------------------------------
   Cards  (GlassContainer / GroupBox)
   -------------------------------------------------------------------------- */
QFrame#GlassContainer {
    background-color: #0c0c0e;
    border: 1px solid #1f1f23;
    border-radius: 12px;
    padding: 4px;
}

QGroupBox {
    background-color: #0c0c0e;
    border: 1px solid #1f1f23;
    border-radius: 12px;
    margin-top: 14px;
    padding: 20px 16px 14px 16px;
    font-weight: 600;
    font-size: 13px;
    color: #fafafa;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #a1a1aa;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    background: #09090b;
}

/* --------------------------------------------------------------------------
   Progress
   -------------------------------------------------------------------------- */
QProgressBar {
    border: none;
    background-color: #18181b;
    border-radius: 3px;
    text-align: center;
    color: #e4e4e7;
    font-size: 11px;
    max-height: 6px;
    min-height: 6px;
}
QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 3px;
}

/* --------------------------------------------------------------------------
   Labels
   -------------------------------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: #e4e4e7;
    border: none;
}
QLabel#HeaderTitle {
    font-size: 22px;
    font-weight: 700;
    color: #fafafa;
}
QLabel#SectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #fafafa;
    padding: 2px 0;
}
QLabel#SubTitle {
    font-size: 13px;
    color: #a1a1aa;
}
QLabel#StatusLabel {
    font-size: 12px;
    color: #a1a1aa;
}

/* --------------------------------------------------------------------------
   CheckBox / Radio
   -------------------------------------------------------------------------- */
QCheckBox, QRadioButton {
    color: #e4e4e7;
    spacing: 8px;
    font-size: 13px;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3f3f46;
    border-radius: 4px;
    background-color: transparent;
}
QCheckBox::indicator:hover {
    border-color: #71717a;
}
QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
    image: url({ICONS_DIR}/../check.svg);
}
QCheckBox::indicator:disabled {
    border-color: #27272a;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    background-color: transparent;
}
QRadioButton::indicator:hover {
    border-color: #71717a;
}
QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #3b82f6, stop:0.45 #3b82f6, stop:0.55 transparent, stop:1 transparent);
    border-color: #3b82f6;
}

/* --------------------------------------------------------------------------
   List Widget
   -------------------------------------------------------------------------- */
QListWidget {
    background-color: #0c0c0e;
    border: 1px solid #1f1f23;
    border-radius: 8px;
    color: #e4e4e7;
    font-size: 13px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 7px 10px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fafafa;
}
QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.04);
}
QListWidget::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
}
QListWidget::indicator:checked {
    background-color: #3b82f6;
    border: 1px solid #3b82f6;
}
QListWidget::indicator:unchecked {
    background-color: transparent;
    border: 1px solid #3f3f46;
}

/* --------------------------------------------------------------------------
   Slider
   -------------------------------------------------------------------------- */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #27272a;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #fafafa;
    border: 1px solid #3b82f6;
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #3b82f6;
    border-radius: 2px;
}

/* --------------------------------------------------------------------------
   Tooltip / Menu / MessageBox / Dialog
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #fafafa;
    color: #09090b;
    border: none;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 12px;
}
QMenu {
    background-color: #111113;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 10px;
    color: #e4e4e7;
    border-radius: 4px;
    margin: 1px 2px;
}
QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.07);
    color: #fafafa;
}
QMenu::separator {
    height: 1px;
    background: #27272a;
    margin: 4px 6px;
}
QMessageBox {
    background-color: #111113;
    color: #e4e4e7;
}
QMessageBox QLabel {
    color: #e4e4e7;
    font-size: 13px;
}
QMessageBox QPushButton {
    min-width: 80px;
    padding: 7px 16px;
}
QDialog {
    background-color: #09090b;
    color: #e4e4e7;
}
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* --------------------------------------------------------------------------
   Splitter
   -------------------------------------------------------------------------- */
QSplitter::handle {
    background-color: #1f1f23;
    width: 1px;
    margin: 4px 2px;
}
QSplitter::handle:hover {
    background-color: #3f3f46;
}

/* --------------------------------------------------------------------------
   Calendar (popup do QDateEdit)
   -------------------------------------------------------------------------- */
QCalendarWidget {
    background-color: #111113;
    color: #e4e4e7;
    border: 1px solid #27272a;
    border-radius: 8px;
}
QCalendarWidget QAbstractItemView {
    background-color: #111113;
    color: #e4e4e7;
    selection-background-color: #3b82f6;
    selection-color: white;
    alternate-background-color: #18181b;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #09090b;
    border-radius: 6px;
    padding: 4px;
}
QCalendarWidget QToolButton {
    color: #e4e4e7;
    background: transparent;
    border: none;
    padding: 6px;
    border-radius: 6px;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background: rgba(255, 255, 255, 0.06);
}

/* --------------------------------------------------------------------------
   ToolButton (grade de estilos, toggles)
   -------------------------------------------------------------------------- */
QToolButton {
    background-color: #0c0c0e;
    color: #e4e4e7;
    border: 1px solid #27272a;
    border-radius: 8px;
    font-weight: 500;
    font-size: 12px;
    padding: 6px;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: #3f3f46;
    color: #fafafa;
}
QToolButton:checked {
    background-color: rgba(59, 130, 246, 0.12);
    border: 1px solid #3b82f6;
    color: #fafafa;
}
QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.08);
}

/* --------------------------------------------------------------------------
   Status bar / separadores
   -------------------------------------------------------------------------- */
QStatusBar {
    background-color: #09090b;
    color: #71717a;
    font-size: 12px;
    border-top: 1px solid #1f1f23;
}
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #1f1f23;
    max-height: 1px;
    border: none;
}

/* --------------------------------------------------------------------------
   Layout de editor (página Legendas): painéis, biblioteca, player, detalhes
   -------------------------------------------------------------------------- */
QFrame#EditorPanel {
    background-color: #0f0f11;
    border: 1px solid #1f1f23;
    border-radius: 10px;
}
QFrame#EditorPanel QWidget {
    background: transparent;
}
QFrame#EditorPanel QFrame#EditorPanelHead {
    border: none;
    border-bottom: 1px solid #1f1f23;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QFrame#EditorPanel QLabel#EditorPanelTitle {
    color: #e4e4e7;
    font-size: 12px;
    font-weight: 600;
}
QLabel#MutedSmall {
    color: #71717a;
    font-size: 11px;
}
QFrame#EditorPanel QFrame#LibraryNav {
    border: none;
    border-right: 1px solid #1f1f23;
}
QFrame#EditorPanel QFrame#LibraryActions {
    border: 1px solid #27272a;
    border-radius: 8px;
}
QFrame#EditorPanel QPushButton#LibraryActionPrimary {
    background-color: rgba(59, 130, 246, 0.10);
    color: #60a5fa;
    border: none;
    border-radius: 6px;
    padding: 7px 8px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}
QFrame#EditorPanel QPushButton#LibraryActionPrimary:hover {
    background-color: rgba(59, 130, 246, 0.18);
}
QFrame#EditorPanel QPushButton#CategoryButton {
    background: transparent;
    color: #a1a1aa;
    border: none;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 12px;
    font-weight: 400;
    text-align: left;
}
QFrame#EditorPanel QPushButton#CategoryButton:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #e4e4e7;
}
QFrame#EditorPanel QPushButton#CategoryButton:checked {
    color: #60a5fa;
    font-weight: 600;
}
QFrame#EditorPanel QLabel#LibrarySection {
    color: #d4d4d8;
    font-size: 12px;
    font-weight: 500;
}
QFrame#EditorPanel QLabel#PlayerCanvas {
    background-color: #050506;
    border-radius: 6px;
    color: #52525b;
}
QFrame#EditorPanel QLabel#PlayerAccent {
    color: #60a5fa;
    font-size: 11px;
    font-weight: 600;
}
QFrame#EditorPanel QLabel#RatioPill {
    color: #a1a1aa;
    border: 1px solid #3f3f46;
    border-radius: 3px;
    font-size: 10px;
    padding: 0 4px;
}
QFrame#EditorPanel QLabel#DetailLabel {
    color: #71717a;
    font-size: 12px;
}
QFrame#EditorPanel QLabel#DetailValue {
    color: #e4e4e7;
    font-size: 12px;
}
QFrame#EditorPanel QFrame#DetailSep,
QFrame#EditorPanel QFrame#ToolbarDivider {
    background-color: #1f1f23;
    border: none;
}
QFrame#EditorPanel QPushButton#SwatchButton {
    background-color: transparent;
    color: #e4e4e7;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 5px 8px;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 11px;
    font-weight: 400;
    text-align: left;
}
QFrame#EditorPanel QPushButton#SwatchButton:hover {
    border-color: #3f3f46;
    background-color: rgba(255, 255, 255, 0.04);
}
QFrame#EditorPanel QPushButton#ProcessButton {
    padding: 8px 10px;
}
QFrame#EditorPanel QListWidget#QueueTrack {
    background: transparent;
    border: none;
    padding: 0;
}
QFrame#EditorPanel QListWidget#QueueTrack::item {
    background-color: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 6px;
    color: #dbeafe;
    padding: 4px 8px;
    font-size: 11px;
}
QFrame#EditorPanel QListWidget#QueueTrack::item:selected {
    background-color: rgba(59, 130, 246, 0.28);
    border: 1px solid #60a5fa;
    color: #ffffff;
}
QFrame#EditorPanel QListWidget#QueueTrack::item:hover:!selected {
    background-color: rgba(59, 130, 246, 0.20);
}
QFrame#EditorPanel QLabel#QueueEmpty {
    color: #52525b;
    font-size: 12px;
    border: 1px dashed #27272a;
    border-radius: 8px;
}
